# 复制为 .env.local 后填写；.env.local 不会被提交到 git

# 云开发环境 ID（控制台 → 环境 → 环境 ID），形如 family-1a2b3c
VITE_TCB_ENV_ID=
TCB_ENV_ID=

# 数据库模式：
#   pg   = PostgreSQL 模式（新版环境，用 rdb + realtime，推荐）
#   doc  = 文档型数据库（传统模式环境）
# 不填则默认 doc
VITE_TCB_MODE=pg

# PG 模式的 Publishable Key（等价于 Supabase 的 anon key）
# 控制台 → 环境 → API 密钥 / 凭证 中获取
VITE_TCB_ACCESS_KEY=

# 腾讯云 API 密钥（仅本机跑 seed 脚本 / CLI 部署用，不要提交）
# 获取地址：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
